{
  "name": "ai-knowledge-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./backend\" --filter \"./frontend\" dev",
    "build": "pnpm --filter \"./backend\" build && pnpm --filter \"./frontend\" build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter \"./backend\" test",
    "test:e2e": "pnpm --filter \"./backend\" test:e2e",
    "db:generate": "pnpm --filter \"./backend\" prisma:generate",
    "db:migrate": "pnpm --filter \"./backend\" prisma:migrate",
    "db:push": "pnpm --filter \"./backend\" prisma:push",
    "docker:up": "docker compose up -d postgres redis",
    "docker:down": "docker compose down"
  }
}
