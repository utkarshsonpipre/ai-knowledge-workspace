# ---------------------------------------------------------------------------
# TEMPLATE ONLY — never put real credentials in this file. It is committed.
# Copy to backend/.env (backend vars) and frontend/.env.local (NEXT_PUBLIC_*),
# both of which are gitignored.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# --- Database (Supabase Postgres w/ pgvector; local dev = docker compose) ----
# Supabase: transaction-mode pooler (port 6543) for the app.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Prisma migrations need a session-mode / direct connection (port 5432).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"
# Local docker-compose publishes Postgres on host port 5433:
#   postgresql://postgres:postgres@localhost:5433/knowledge_workspace?schema=public

# --- Auth -------------------------------------------------------------------
# 32+ random characters each, and different from one another.
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

GITHUB_CLIENT_ID=""
GITHUB_SECRET=""
# Must match the callback URL registered on the GitHub OAuth app.
GITHUB_CALLBACK_URL="http://localhost:4000/api/auth/github/callback"

# --- Frontend origin (CORS + OAuth redirect target) -------------------------
FRONTEND_URL="http://localhost:3000"
# Cookie domain for the refresh token. Leave empty for localhost.
COOKIE_DOMAIN=""

# --- Redis (BullMQ). Upstash: use the rediss:// TCP endpoint, NOT the REST URL
REDIS_URL="redis://localhost:6379"

# --- AI ---------------------------------------------------------------------
# xAI/Grok:  base https://api.x.ai/v1             model grok-4-fast
# Groq:      base https://api.groq.com/openai/v1  model llama-3.3-70b-versatile
GROK_API_KEY=""
GROK_BASE_URL="https://api.x.ai/v1"
GROK_MODEL="grok-4-fast"

# EMBEDDING_PROVIDER: "local" (Xenova/all-MiniLM-L6-v2, free) | "openai"
EMBEDDING_PROVIDER="local"
OPENAI_API_KEY=""
# Both providers emit 384-dim vectors (OpenAI via the `dimensions` param),
# so the pgvector column dimension never changes when you swap providers.
EMBEDDING_DIMENSIONS=384

# --- Storage (Supabase Storage) ---------------------------------------------
SUPABASE_URL=""
# Service-role key: server-side only. Never expose it to the browser.
SUPABASE_SERVICE_KEY=""
SUPABASE_STORAGE_BUCKET="knowledge-files"

# --- Observability ----------------------------------------------------------
SENTRY_DSN=""

# --- Frontend (frontend/.env.local) -----------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
NEXT_PUBLIC_SUPABASE_URL=""
# Anon key only — never the service-role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_SUPABASE_BUCKET="knowledge-files"
NEXT_PUBLIC_SENTRY_DSN=""
